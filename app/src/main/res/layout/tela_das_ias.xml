<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroud"
    tools:context=".TelaDasIas">

    <ImageView
        android:id="@+id/btn_perfil"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_titulo_ias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Inteligências Artificiais"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_subtitulo_ias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clique na IA desejada para ir ao site"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_titulo_ias" />

    <!-- IA 1: Grok -->
    <ImageView
        android:id="@+id/bg_ia_1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/container_components"
        app:layout_constraintEnd_toStartOf="@id/bg_ia_2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_subtitulo_ias" />

    <ImageView
        android:id="@+id/ia_1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/img_3"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_1"
        app:layout_constraintEnd_toEndOf="@id/bg_ia_1"
        app:layout_constraintStart_toStartOf="@id/bg_ia_1"
        app:layout_constraintTop_toTopOf="@id/bg_ia_1" />

    <!-- IA 2: ChatGPT -->
    <ImageView
        android:id="@+id/bg_ia_2"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/container_components"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bg_ia_1"
        app:layout_constraintTop_toTopOf="@id/bg_ia_1" />

    <ImageView
        android:id="@+id/ia_2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/img_4"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_2"
        app:layout_constraintEnd_toEndOf="@id/bg_ia_2"
        app:layout_constraintStart_toStartOf="@id/bg_ia_2"
        app:layout_constraintTop_toTopOf="@id/bg_ia_2" />

    <!-- IA 3: Gemini -->
    <ImageView
        android:id="@+id/bg_ia_3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/container_components"
        app:layout_constraintEnd_toStartOf="@id/bg_ia_4"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_ia_1" />

    <ImageView
        android:id="@+id/ia_3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/img_5"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_3"
        app:layout_constraintEnd_toEndOf="@id/bg_ia_3"
        app:layout_constraintStart_toStartOf="@id/bg_ia_3"
        app:layout_constraintTop_toTopOf="@id/bg_ia_3" />

    <!-- IA 4: Copilot -->
    <ImageView
        android:id="@+id/bg_ia_4"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/container_components"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bg_ia_3"
        app:layout_constraintTop_toTopOf="@id/bg_ia_3" />

    <ImageView
        android:id="@+id/ia_4"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/img_6"
        app:layout_constraintBottom_toBottomOf="@id/bg_ia_4"
        app:layout_constraintEnd_toEndOf="@id/bg_ia_4"
        app:layout_constraintStart_toStartOf="@id/bg_ia_4"
        app:layout_constraintTop_toTopOf="@id/bg_ia_4" />

</androidx.constraintlayout.widget.ConstraintLayout>
